# Copy to .env (never commit .env). Local defaults live in docker/local.env;
# anything set here overrides them. Production values are set in hPanel /
# wp-config.php on the server, never in Git.

# Hostinger
HOSTINGER_SSH_HOST=
HOSTINGER_SSH_PORT=
HOSTINGER_SSH_USER=
PATH_MARKETING=
PATH_JOURNAL=
PATH_STUDIOS=
PATH_STAGING=
# Startbuddi — one endpoint URL per form (copy from Startbuddi → Forms → <endpoint form> → settings)
SB_ENDPOINT_CONTACT=
SB_ENDPOINT_AUDIT=
SB_ENDPOINT_STUDIOS_BRIEF=
SB_ENDPOINT_NEWSLETTER=
SB_ENDPOINT_LEAD_MAGNET=
SB_ENDPOINT_TOOL_GATE=
SB_ENDPOINT_POPUP_EXIT=
SB_ENDPOINT_POPUP_SCROLL=
SB_ENDPOINT_MVP_CALC=
SB_ENDPOINT_GUEST_POST=  SB_ENDPOINT_QUOTE=
SB_SHARED_SECRET=
# Spam
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Ads + analytics
ADSENSE_PUBLISHER_ID=
GA4_ID=
GTM_ID=
CLARITY_ID=
# AI-powered tools (§12.1)
AI_API_KEY=
AI_MODEL=
# Cross-site base URLs (td_url()). Leave empty in production to use the real domains.
TD_URL_MARKETING=
TD_URL_JOURNAL=
TD_URL_STUDIOS=
# Staging basic auth (§5.3)
STAGING_BASIC_AUTH_USER=
STAGING_BASIC_AUTH_PASS=
# Misc
TD_ENV=
