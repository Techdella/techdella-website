# Local defaults (committed, no secrets). .env overrides any of these.
TD_ENV=local
TD_URL_MARKETING=http://localhost:8081
TD_URL_JOURNAL=http://localhost:8082
TD_URL_STUDIOS=http://localhost:8083
# Every form posts to the Startbuddi mock (§11.5).
SB_ENDPOINT_CONTACT=http://sb-mock:8090/forms/contact
SB_ENDPOINT_AUDIT=http://sb-mock:8090/forms/audit
SB_ENDPOINT_STUDIOS_BRIEF=http://sb-mock:8090/forms/studios_brief
SB_ENDPOINT_NEWSLETTER=http://sb-mock:8090/forms/newsletter
SB_ENDPOINT_LEAD_MAGNET=http://sb-mock:8090/forms/lead_magnet
SB_ENDPOINT_TOOL_GATE=http://sb-mock:8090/forms/tool_gate
SB_ENDPOINT_POPUP_EXIT=http://sb-mock:8090/forms/popup_exit
SB_ENDPOINT_POPUP_SCROLL=http://sb-mock:8090/forms/popup_scroll
SB_ENDPOINT_MVP_CALC=http://sb-mock:8090/forms/mvp_calc
SB_ENDPOINT_GUEST_POST=http://sb-mock:8090/forms/guest_post
SB_ENDPOINT_QUOTE=http://sb-mock:8090/forms/quote
# Placeholder publisher ID so ads.txt renders locally. Not a real account.
ADSENSE_PUBLISHER_ID=ca-pub-0000000000000000
# Mail goes to Mailpit.
TD_SMTP_HOST=mailpit
TD_SMTP_PORT=1025
