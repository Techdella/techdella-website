{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techdella/service-switcher",
	"title": "Service switcher",
	"category": "techdella",
	"icon": "menu-alt3",
	"description": "Pill row under the nav that links the service pages; the current page is highlighted with aria-current.",
	"editorScript": "techdella-blocks-editor",
	"render": "file:./render.php",
	"supports": { "html": false, "anchor": true },
	"attributes": {
		"label": { "type": "string", "default": "Services" },
		"items": { "type": "array", "default": [] },
		"current": { "type": "string", "default": "" }
	},
	"example": {
		"attributes": {
			"label": "Services",
			"current": "/services/seo/",
			"items": [
				{ "label": "SEO", "url": "/services/seo/" },
				{ "label": "AI Search", "url": "/services/ai-search-optimization/" },
				{ "label": "Paid ads", "url": "/services/paid-ads/" },
				{ "label": "Lead generation", "url": "/services/lead-generation/" },
				{ "label": "Email marketing", "url": "/services/email-marketing/" },
				{ "label": "AI automations", "url": "/services/marketing-automation/" }
			]
		}
	},
	"techdella": {
		"controls": { "items": "json" },
		"help": "Items: [{label, url}]. Leave items empty for the six services. The current page is detected from the URL; set \"current\" (a URL path or label) to force it, e.g. on SEO children use items SEO / Technical SEO / Local SEO / AI Search."
	}
}
