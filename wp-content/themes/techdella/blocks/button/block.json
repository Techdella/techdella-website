{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techdella/button",
	"title": "Button",
	"category": "techdella",
	"icon": "button",
	"description": "Brand button: primary (black pill + orange arrow), secondary (white pill, ink border) or light (for dark sections).",
	"editorScript": "techdella-blocks-editor",
	"render": "file:./render.php",
	"supports": { "html": false, "anchor": true },
	"attributes": {
		"label": { "type": "string", "default": "Get a growth audit" },
		"url": { "type": "string", "default": "/growth-audit/" },
		"variant": { "type": "string", "enum": [ "primary", "secondary", "light" ], "default": "primary" },
		"size": { "type": "string", "enum": [ "md", "sm" ], "default": "md" },
		"align": { "type": "string", "enum": [ "start", "center" ], "default": "start" }
	},
	"example": {
		"attributes": { "label": "Get a growth audit", "url": "/growth-audit/", "variant": "primary", "size": "md" }
	},
	"techdella": {
		"controls": { "url": "url" },
		"help": "One primary button per section. Use 'light' on dark backgrounds. Relative URLs (/growth-audit/) resolve on the current site."
	}
}
