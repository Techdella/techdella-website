{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "techdella/stats",
	"title": "Stats",
	"category": "techdella",
	"icon": "chart-bar",
	"description": "Two to four headline numbers, each with a label and a named, linked source (E-E-A-T: no unsourced numbers).",
	"editorScript": "techdella-blocks-editor",
	"render": "file:./render.php",
	"supports": {
		"html": false,
		"anchor": true
	},
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"items": {
			"type": "array",
			"default": []
		},
		"highlight": {
			"type": "integer",
			"default": 0
		}
	},
	"example": {
		"attributes": {
			"title": "B2B buying in numbers",
			"items": [
				{
					"value": "50%",
					"label": "of Paycape’s conversions came from inbound",
					"source": "TechDella case study, 2025",
					"url": "/case-studies/paycape/"
				},
				{
					"value": "50 days",
					"label": "to Paycape’s first result",
					"source": "TechDella case study, 2025",
					"url": "/case-studies/paycape/"
				},
				{
					"value": "~15,000",
					"label": "monthly organic visitors",
					"source": "TechDella case study, 2025",
					"url": "/case-studies/paycape/"
				}
			]
		}
	},
	"techdella": {
		"controls": {
			"items": "json"
		},
		"help": "items: 2–4 {value, label, source, url}. Every number needs a source; our own numbers link to the case study. highlight: index of the one stat shown in orange (0 = first, -1 = none)."
	}
}
