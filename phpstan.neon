includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
	level: 5
	paths:
		- wp-content/themes/techdella
		- wp-content/mu-plugins
	excludePaths:
		- wp-content/themes/techdella/assets/*
	scanFiles:
		- vendor/php-stubs/wp-cli-stubs/wp-cli-stubs.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	dynamicConstantNames:
		- TD_SITE
		- TD_ENV
		- TD_URL_MARKETING
		- TD_URL_JOURNAL
		- TD_URL_STUDIOS
		- SB_ENDPOINT_CONTACT
		- SB_ENDPOINT_AUDIT
		- SB_ENDPOINT_STUDIOS_BRIEF
		- SB_ENDPOINT_NEWSLETTER
		- SB_ENDPOINT_LEAD_MAGNET
		- SB_ENDPOINT_TOOL_GATE
		- SB_ENDPOINT_POPUP_EXIT
		- SB_ENDPOINT_POPUP_SCROLL
		- SB_ENDPOINT_MVP_CALC
		- SB_ENDPOINT_GUEST_POST
		- SB_SHARED_SECRET
		- TURNSTILE_SITE_KEY
		- TURNSTILE_SECRET_KEY
		- ADSENSE_PUBLISHER_ID
		- GA4_ID
		- GTM_ID
		- CLARITY_ID
		- AI_API_KEY
		- AI_MODEL
		- STAGING_BASIC_AUTH_USER
		- STAGING_BASIC_AUTH_PASS
		- TD_SMTP_HOST
		- TD_SMTP_PORT
		- TD_THEME_VERSION
		- TD_CORE_VERSION
		- TD_CORE_DIR
		- TD_CORE_URL
